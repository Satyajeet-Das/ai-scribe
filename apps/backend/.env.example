# ============================================================================
# AI Exam Scribe - Environment Configuration
# ============================================================================

# Primary Environment (local | development | staging | production)
SCRIBE_PRIMARY.ENV="local"

# HTTP Server Configuration
SCRIBE_SERVER.PORT="8080"
SCRIBE_SERVER.READ_TIMEOUT="30"
SCRIBE_SERVER.WRITE_TIMEOUT="30"
SCRIBE_SERVER.IDLE_TIMEOUT="60"
SCRIBE_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# PostgreSQL Database Configuration
SCRIBE_DATABASE.HOST="localhost"
SCRIBE_DATABASE.PORT="5432"
SCRIBE_DATABASE.USER="postgres"
SCRIBE_DATABASE.PASSWORD="postgres"
SCRIBE_DATABASE.NAME="ai_scribe"
SCRIBE_DATABASE.SSL_MODE="disable"
SCRIBE_DATABASE.MAX_OPEN_CONNS="25"
SCRIBE_DATABASE.MAX_IDLE_CONNS="25"
SCRIBE_DATABASE.CONN_MAX_LIFETIME="300"
SCRIBE_DATABASE.CONN_MAX_IDLE_TIME="300"

# Redis Configuration (Cache / Worker Queue)
SCRIBE_REDIS.ADDRESS="localhost:6379"

# Authentication (Pluggable JWT / Clerk)
SCRIBE_AUTH.SECRET_KEY="sk_test_placeholder"
SCRIBE_AUTH.ACCESS_TOKEN_DURATION="900"
SCRIBE_AUTH.REFRESH_TOKEN_DURATION="604800"
SCRIBE_AUTH.ISSUER="ai-scribe"

# Integrations (Resend Email)
SCRIBE_INTEGRATION.RESEND_API_KEY="re_test_placeholder"

# ============================================================================
# Observability Configuration
# ============================================================================
SCRIBE_OBSERVABILITY.SERVICE_NAME="ai-scribe"
SCRIBE_OBSERVABILITY.ENVIRONMENT="development"

# Logging Settings
SCRIBE_OBSERVABILITY.LOGGING.LEVEL="debug"
SCRIBE_OBSERVABILITY.LOGGING.FORMAT="console"
SCRIBE_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# New Relic APM (Optional)
SCRIBE_OBSERVABILITY.NEW_RELIC.LICENSE_KEY=""
SCRIBE_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="false"
SCRIBE_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="false"
SCRIBE_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# Health Checks
SCRIBE_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
SCRIBE_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
SCRIBE_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
SCRIBE_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"

# ============================================================================
# Voice Pipeline (Sprints 7-10): WebSocket, STT, intent classification, TTS
# Every value below is optional; the defaults are shown.
# ============================================================================
SCRIBE_VOICE.ENABLED="true"
# Origins allowed to open the WebSocket. Empty = SCRIBE_SERVER.CORS_ALLOWED_ORIGINS.
SCRIBE_VOICE.ALLOWED_ORIGINS=""
SCRIBE_VOICE.MAX_CONNECTIONS="500"
SCRIBE_VOICE.MAX_CONNECTIONS_PER_USER="3"
SCRIBE_VOICE.MAX_MESSAGE_BYTES="65536"
SCRIBE_VOICE.SEND_QUEUE_SIZE="128"
SCRIBE_VOICE.WRITE_TIMEOUT="10s"
SCRIBE_VOICE.PING_INTERVAL="20s"
SCRIBE_VOICE.PONG_TIMEOUT="10s"
SCRIBE_VOICE.SHUTDOWN_GRACE="10s"
SCRIBE_VOICE.ACTION_TIMEOUT="8s"
SCRIBE_VOICE.CONFIRMATION_TTL="45s"
SCRIBE_VOICE.AUTH_EXPIRY_GRACE="30s"

# Audio ingestion limits (mono PCM16LE)
SCRIBE_VOICE.AUDIO.MAX_CHUNK_BYTES="32768"
SCRIBE_VOICE.AUDIO.MAX_STREAM_BYTES="2097152"
SCRIBE_VOICE.AUDIO.MAX_STREAM_DURATION="45s"
SCRIBE_VOICE.AUDIO.BUFFER_CHUNKS="32"
SCRIBE_VOICE.AUDIO.ENQUEUE_TIMEOUT="2s"

# Speech-to-text: disabled | deepgram
SCRIBE_VOICE.STT.PROVIDER="disabled"
SCRIBE_VOICE.STT.API_KEY=""
SCRIBE_VOICE.STT.BASE_URL="wss://api.deepgram.com"
SCRIBE_VOICE.STT.MODEL="nova-3"
SCRIBE_VOICE.STT.LANGUAGE="en"
SCRIBE_VOICE.STT.CONNECT_TIMEOUT="5s"
SCRIBE_VOICE.STT.FINAL_TIMEOUT="8s"
SCRIBE_VOICE.STT.MAX_CONCURRENT="50"

# Text-to-speech: disabled | deepgram
SCRIBE_VOICE.TTS.PROVIDER="disabled"
SCRIBE_VOICE.TTS.API_KEY=""
SCRIBE_VOICE.TTS.BASE_URL="https://api.deepgram.com"
SCRIBE_VOICE.TTS.MODEL="aura-2-thalia-en"
SCRIBE_VOICE.TTS.SAMPLE_RATE="24000"
SCRIBE_VOICE.TTS.CHUNK_BYTES="8192"
SCRIBE_VOICE.TTS.TIMEOUT="60s"
SCRIBE_VOICE.TTS.MAX_CONCURRENT="50"

# Intent classification: rules (offline, exact commands only)
#   | anthropic (rules first, then Claude; needs API_KEY)
#   | ollama    (rules first, then a local model; needs BASE_URL + MODEL, no key)
# For Ollama: install it, run `ollama pull llama3.2`, then set
#   PROVIDER="ollama", BASE_URL="http://localhost:11434", MODEL="llama3.2".
SCRIBE_VOICE.INTENT.PROVIDER="rules"
SCRIBE_VOICE.INTENT.API_KEY=""
SCRIBE_VOICE.INTENT.BASE_URL="http://localhost:11434"
SCRIBE_VOICE.INTENT.MODEL="claude-opus-5-5"
SCRIBE_VOICE.INTENT.PROMPT_VERSION="v1"
# Optional path to a prompt file that overrides the embedded prompt version.
SCRIBE_VOICE.INTENT.PROMPT_FILE=""
SCRIBE_VOICE.INTENT.TIMEOUT="8s"
SCRIBE_VOICE.INTENT.MIN_CONFIDENCE="0.75"
SCRIBE_VOICE.INTENT.MAX_CONCURRENT="20"
SCRIBE_VOICE.INTENT.MAX_TRANSCRIPT_CHARS="2000"

# --- Answer audio retention (OFF unless enabled) -----------------------------
# Keeping audio of students is an institutional decision (notice, consent or
# authorization, retention). Enable it only once that is settled.
# SCRIBE_RECORDING.ENABLED="false"
# "localfs" keeps files under DIR; "s3" uses an S3-compatible bucket (MinIO, AWS S3, ...)
# SCRIBE_RECORDING.PROVIDER="localfs"
# SCRIBE_RECORDING.DIR="./data/audio"
# --- s3 / MinIO. In production use_ssl must be true and create_bucket false.
# SCRIBE_RECORDING.S3.ENDPOINT="localhost:9000"
# SCRIBE_RECORDING.S3.BUCKET="answer-audio"
# SCRIBE_RECORDING.S3.ACCESS_KEY=""
# SCRIBE_RECORDING.S3.SECRET_KEY=""
# SCRIBE_RECORDING.S3.REGION="us-east-1"
# SCRIBE_RECORDING.S3.USE_SSL="false"
# SCRIBE_RECORDING.S3.CREATE_BUCKET="false"
# 0 = no retention date is recorded and nothing is deleted automatically
# SCRIBE_RECORDING.RETENTION_DAYS="0"
# --- Cleanup job: deletes audio past its retention date; off unless enabled. It never
# touches a recording that has no retention date. Orphan removal is a separate opt-in
# and needs a bucket/directory used only by this application.
# SCRIBE_RECORDING.CLEANUP.ENABLED="false"
# SCRIBE_RECORDING.CLEANUP.INTERVAL="1h"
# SCRIBE_RECORDING.CLEANUP.BATCH_SIZE="100"
# Dictations a student never confirmed (said no, dictated again, walked away) are deleted
# after this long. Turn cleanup on whenever recording is on, or they are kept indefinitely.
# SCRIBE_RECORDING.CLEANUP.UNCONFIRMED_GRACE="1h"
# SCRIBE_RECORDING.CLEANUP.ORPHAN_GRACE="1h"
# SCRIBE_RECORDING.CLEANUP.DELETE_ORPHANS="false"
